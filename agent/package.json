{
  "name": "beaver-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "build:client": "esbuild client/voice-entry.js --bundle --format=esm --minify --target=es2022 --outfile=public/app/voice-client.js",
    "link": "node scripts/link.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "build": "npm run build:ui && npm run build:client"
  },
  "dependencies": {
    "agents": "^0.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.146.0"
  }
}
