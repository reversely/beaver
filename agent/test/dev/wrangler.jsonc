// Local only: the agent with a Workers AI stub (entry.ts). Never deployed.
{
  "name": "beaver-agent-dev",
  "main": "entry.ts",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "../../public" },
  "durable_objects": { "bindings": [{ "name": "BeaverGuide", "class_name": "BeaverGuide" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BeaverGuide"] }],
  "vars": {
    "ANSWER_MODEL": "stub-answer",
    "TRANSLATE_MODEL": "stub-m2m100",
    "SPEECH_MODEL": "stub-melotts"
  }
}
