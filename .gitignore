# Session log: local handoff between sessions, never staged.
docs/log.md

# secrets baseline is committed; the actual secrets it would catch are not
.env
.env.*
!.env.example

# Python / uv
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# OS noise
.DS_Store

# agent-local files: instructions, skills, settings, worklogs, plans, PRDs
CLAUDE.md
AGENTS.md
.claude/
docs/log.md
docs/progress/
docs/plans/
docs/prd*.md

# Experiment run output: prompts, replies, recordings, camera frames
experiments/*/runs/

# Downloaded test images, kept local for licensing
experiments/*/test-images/

# Settings saved from the experiment 001 web interface
experiments/*/settings.local.json

# Review notebooks built by the experiment 001 interface
experiments/*/notebooks/

# Downloaded translation models
experiments/*/models/

# TLS certificates and keys, such as the phone hotspot certificate for experiment 002.
*.pem

# Rover turns pulled by the desktop app for its notebooks
experiments/*/rover-runs/
